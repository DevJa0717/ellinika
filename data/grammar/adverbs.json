  {
   "section": "7.2",
   "title": "The use of adverbs and adverbial phrases",
   "pdf_pages": "5-10",
   "rule": "Most adverbs modify a verb. Some modify an adjective, another adverb, a participle, a noun, a numeral/quantifier, or a whole sentence; some can stand alone as an utterance.",
   "subsections": [
    {
     "id": "verb",
     "rule": "Modifying a verb: manner, place, time, quantity.",
     "examples": [
      {
       "el": "Μίλησε καλά.",
       "en": "(S)he spoke well."
      },
      {
       "el": "Μίλησε εδώ.",
       "en": "(S)he spoke here."
      },
      {
       "el": "Μίλησε χθες.",
       "en": "(S)he spoke yesterday."
      },
      {
       "el": "Μίλησε πολύ.",
       "en": "(S)he spoke a lot."
      },
      {
       "el": "Μου άρεσε περισσότερο.",
       "en": "I liked (him/her/it) more."
      },
      {
       "el": "Μου άρεσε λιγότερο.",
       "en": "I liked (him/her/it) less."
      },
      {
       "el": "Μου άρεσε αρκετά.",
       "en": "I liked (him/her/it) quite a lot."
      }
     ]
    },
    {
     "id": "participle-adverb",
     "rule": "Manner adverbs may modify a perfect passive participle; some time adverbs may modify an adjective or adverb.",
     "examples": [
      {
       "el": "καλά εκπαιδευμένος",
       "en": "well trained"
      },
      {
       "el": "αμέσως μετά",
       "en": "immediately afterwards"
      },
      {
       "el": "Φοβάμαι λίγο.",
       "en": "I'm a bit frightened."
      }
     ]
    },
    {
     "id": "quantity-with-adj-adv",
     "rule": "Adverbs of quantity commonly modify adjectives and adverbs (the adjective may agree, or the adverb form is used, as in καλός/καλά).",
     "examples": [
      {
       "el": "πολύ καλός/καλά",
       "en": "very good/well"
      },
      {
       "el": "πολύ καλύτερος/καλύτερα",
       "en": "much better"
      },
      {
       "el": "τόσο καλός/καλά",
       "en": "so good/well"
      },
      {
       "el": "λίγο καλύτερος/καλύτερα",
       "en": "a little better"
      },
      {
       "el": "λιγότερο καλός/καλά",
       "en": "less good/well"
      },
      {
       "el": "καθόλου καλός/καλά",
       "en": "not at all good/well"
      },
      {
       "el": "αρκετά καλός/καλά",
       "en": "quite good/well"
      },
      {
       "el": "πάρα πολύ καλός/καλά",
       "en": "extremely good/well"
      },
      {
       "el": "πιο καλός/καλά",
       "en": "better"
      }
     ]
    },
    {
     "id": "place-adverb-combos",
     "rule": "Adverbs often modify adverbs of place, with combinations unlike English; πιο is written together with the following word in these examples.",
     "examples": [
      {
       "el": "πιοεδώ/εκεί",
       "en": "on this/that side (lit. 'more here/there')"
      },
      {
       "el": "πιοπάνω/κάτω",
       "en": "further up/down"
      },
      {
       "el": "πιοπριν",
       "en": "earlier (lit. 'more before')"
      },
      {
       "el": "εδώ/εκεί πάνω, εδώ/εκεί κάτω",
       "en": "up here/there, down here/there"
      },
      {
       "el": "εδώ/εκεί κοντά",
       "en": "near here/there"
      }
     ]
    },
    {
     "id": "modify-noun",
     "rule": "A few place/time adverbs can modify a noun.",
     "examples": [
      {
       "el": "η πίσω πόρτα",
       "en": "the back door"
      },
      {
       "el": "η τότε κυβέρνηση",
       "en": "the then government"
      }
     ]
    },
    {
     "id": "modify-numeral",
     "rule": "A few quantity adverbs can modify a numeral or quantifier.",
     "examples": [
      {
       "el": "σχεδόν όλοι",
       "en": "almost everybody"
      },
      {
       "el": "τουλάχιστον τέσσερις φορές",
       "en": "at least four times"
      }
     ]
    },
    {
     "id": "standalone",
