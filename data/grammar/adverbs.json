    },
    {
     "id": "sentence-adverbs",
     "rule": "Some adverbs may stand alone or modify a whole sentence.",
     "list": [
      {
       "el": "ίσως",
       "en": "perhaps"
      },
      {
       "el": "ασφαλώς",
       "en": "certainly"
      },
      {
       "el": "βέβαια",
       "en": "of course"
      },
      {
       "el": "σίγουρα",
       "en": "of course"
      },
      {
       "el": "φυσικά",
       "en": "naturally"
      },
      {
       "el": "ευτυχώς",
       "en": "fortunately, luckily"
      },
      {
       "el": "δυστυχώς",
       "en": "unfortunately"
      }
     ]
    },
    {
     "id": "adverb-plus-που",
     "rule": "Some adverbs (notably τώρα, τότε, εδώ, εκεί, καλά, ωραία, ευτυχώς, μόνο) take a complement clause introduced by που in idiomatic uses.",
     "examples": [
      {
       "el": "τώρα που το λες",
       "en": "now that you mention it"
      },
      {
       "el": "τότε που ήμασταν νέοι",
       "en": "when we were young"
      },
      {
       "el": "Από δω που κάθομαι, δεν σε βλέπω.",
       "en": "From where I'm sitting I can't see you."
      },
      {
       "el": "Εκεί που περίμενα τον Γιάννη, ήρθε η Σοφία.",
       "en": "Whereas I was expecting John, Sophie came."
      },
      {
       "el": "Καλά που το σκέφτηκες!",
       "en": "[It's a] good [thing] you thought of it!"
      },
      {
       "el": "Ευτυχώς που μου το είπες!",
       "en": "[It's] lucky you told me!"
      },
      {
       "el": "Θα το αγόραζα, μόνο που είναι ακριβό.",
       "en": "I would buy it, only it's expensive."
      }
     ]
    },
    {
     "id": "place-adverbs-as-prepositions",
     "rule": "Place adverbs πάνω, κάτω, μέσα, έξω, μπροστά, πίσω, κοντά, μακριά, ανάμεσα, απέναντι, δίπλα, πλάι, γύρω, πέρα can act as prepositions with the genitive of the weak pronoun, or combine with prepositions as compound prepositions (see prepositions.json §8.3)."
    },
    {
     "id": "indefinite-adverbs",
     "rule": "The non-specific indefinite adverbs πουθενά, ποτέ, καθόλου occur in questions, negative clauses or other non-statement clauses, or alone (compare non-specific indefinite pronouns, §4.6).",
     "examples": [
