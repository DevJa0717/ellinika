  {
   "section": "11.2",
   "title": "Prefixation",
   "pdf_pages": "afb4adc8 pp.40-42",
   "rule": "The commonest prefixes are prepositions, including Ancient Greek ones that no longer exist as independent prepositions (list in 6.23). Each has a wide range of meanings. The same base verb takes different prefixes to give different meanings, each usually with a matching feminine noun.",
   "example_family": {
    "base": "δίνω (usually -δίδω)",
    "verbs": [
     {
      "el": "αποδίδω",
      "en": "I give back, attribute"
     },
     {
      "el": "διαδίδω",
      "en": "I give out, disseminate"
     },
     {
      "el": "εκδίδω",
      "en": "I issue, publish"
     },
     {
      "el": "μεταδίδω",
      "en": "I transmit"
     },
     {
      "el": "παραδίδω",
      "en": "I hand over"
     },
     {
      "el": "προδίδω / προδίνω",
      "en": "I betray"
     },
     {
      "el": "ανταποδίδω",
      "en": "I give in return (two prefixes)"
     }
    ],
    "nouns": [
     {
      "el": "απόδοση",
      "en": "yield, rendering"
     },
     {
      "el": "διάδοση",
      "en": "dissemination"
     },
     {
      "el": "έκδοση",
      "en": "issue, publication"
     },
     {
      "el": "μετάδοση",
      "en": "transmission"
     },
     {
      "el": "παράδοση",
      "en": "surrender, tradition"
     },
     {
      "el": "προδοσία",
      "en": "betrayal"
     },
     {
      "el": "ανταπόδοση",
      "en": "repayment"
     }
    ]
   },
   "prefixes": [
    {
     "prefix": "ανα- / επανα-",
     "meaning": "re-",
     "examples": [
      {
       "el": "αναπαλαίωση",
       "en": "restoration (lit. making old again)"
      },
      {
       "el": "επανεκλέγω",
       "en": "I re-elect"
      }
     ]
    },
    {
     "prefix": "αντι-",
     "meaning": "in place of, vice-, against, anti-",
     "examples": [
      {
       "el": "αντιπρόεδρος",
       "en": "vice-president"
      },
      {
       "el": "αντικομμουνιστικός",
       "en": "anticommunist (adj.)"
      }
     ]
    },
    {
     "prefix": "απο-",
     "meaning": "de-, dis-",
     "examples": [
      {
       "el": "αποσύνθεση",
       "en": "decomposition"
      },
      {
       "el": "απολυμαντικό",
       "en": "disinfectant"
      }
     ]
    },
    {
     "prefix": "δια-",
     "meaning": "inter-",
     "examples": [
      {
       "el": "διαδίκτυο",
       "en": "internet"
      },
      {
       "el": "διακρατικός",
       "en": "interstate"
