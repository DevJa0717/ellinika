     "case": "accusative",
     "gloss": "from; since; by; than",
     "pdf_pages": "17-19",
     "colloquial_form": "απ' before the definite article (απ' την Αθήνα)",
     "uses": [
      {
       "meaning": "from (place)",
       "examples": [
        {
         "el": "Είμαι από την Αθήνα.",
         "en": "I'm from Athens."
        },
        {
         "el": "Έφυγα από την Αθήνα.",
         "en": "I left Athens."
        }
       ]
      },
      {
       "meaning": "from/of (cause)",
       "examples": [
        {
         "el": "Θα πεθάνω από την πείνα.",
         "en": "I'll die of hunger."
        }
       ]
      },
      {
       "meaning": "from/since (time)",
       "examples": [
        {
         "el": "Περίμενα από το πρωί μέχρι το βράδυ.",
         "en": "I waited from morning till evening."
        },
        {
         "el": "Μένω στην Πάτρα από το 1992.",
         "en": "I've been living in Patras since 1992."
        }
       ]
      },
      {
       "meaning": "of (partitive)",
       "examples": [
        {
         "el": "ένας από τους διαβάτες",
         "en": "one of the passers-by"
        },
        {
         "el": "κανένας από σας",
         "en": "none of you"
        }
       ],
       "note": "emphatic with pronouns"
      },
      {
       "meaning": "by (agent)",
       "examples": [
        {
