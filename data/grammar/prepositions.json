    {
     "el": "από",
     "en": "from; since; by; than"
    },
    {
     "el": "για",
     "en": "for; about"
    },
    {
     "el": "μέχρι",
     "en": "until, up to"
    },
    {
     "el": "με",
     "en": "with"
    },
