    {
     "el": "σε",
     "en": "to, into; at, in"
    },
    {
     "el": "χωρίς",
     "en": "without"
    }
   ],
   "examples": [
    {
     "el": "στην Αθήνα",
     "en": "to/in Athens"
    },
    {
     "el": "σ' εμένα",
     "en": "to me (contrastive emphasis)"
    },
    {
