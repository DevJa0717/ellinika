 "title": "Suffixes for places, containers, trees, small things and big things",
 "level": "A2–B2",
 "intro": [
  {
   "p": "Where something happens (-είο, -τήριο), what holds it (-θήκη, -ιέρα), which tree bears it or which blow it gives (-ιά), and how you feel about its size (-άκι, -ούλα, -άρα)."
  }
 ],
