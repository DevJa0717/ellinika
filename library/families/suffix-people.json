{
 "id": "suffix-people",
 "part": "Γ",
 "el": "Πρόσωπα: ποιος κάνει τι",
 "title": "Suffixes for people: doers, trades, origin, women's forms",
 "level": "A2–B2",
 "intro": [
  {
   "p": "A suffix tells you the word class before you know the meaning. These ones make **people**: the one who does something (-της, -έας), the one who practises a trade (-άς, -άρης, -τζής), the one who comes from somewhere (-αίος, -ιώτης, -ινός), and the women's forms that go with them."
  }
 ],
