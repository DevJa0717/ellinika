"why": "Superlative + genitive: της ζωής μου.",
"id": "comparison-37fdde63"
},
{
"type": "write",
"q": "Translate: \"the biggest problem\"",
"answer": "το μεγαλύτερο πρόβλημα",
"accept": [
"το πιο μεγάλο πρόβλημα"
],
"why": "Article + comparative.",
"id": "comparison-e56b8fb0"
},
{
"type": "write",
"q": "Translate: \"the worst day\"",
"answer": "η χειρότερη μέρα",
"accept": [
"η πιο κακή μέρα"
],
"why": "Article + comparative.",
"id": "comparison-d1778769"
},
{
"type": "write",
