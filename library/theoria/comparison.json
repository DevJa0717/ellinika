"options": [
"λιγότατη",
"ελάχιστη",
"πιο λίγη",
"μικρότατη πολύ"
],
"answer": "ελάχιστη",
"why": "ελάχιστος = minimal.",
"id": "comparison-80c62e59"
},
{
"type": "write",
"q": "Translate: \"very cheap\" (το κρασί)",
"answer": "πολύ φτηνό",
"accept": [
"φτηνότατο"
],
"why": "πολύ + adjective, or -ότατο.",
"id": "comparison-b3400204"
},
{
"type": "write",
"q": "Translate: \"really fresh fish\" (τα ψάρια)",
"answer": "ολόφρεσκα ψάρια",
"accept": [],
"why": "ολο- + adjective.",
"id": "comparison-c7b26110"
},
{
"type": "write",
"q": "Translate: \"little by little\"",
"answer": "σιγά σιγά",
"accept": [],
"why": "Repetition.",
"id": "comparison-a177ce41"
},
