"η ανάπτυξη"
],
[
"βελτιώνω improve",
"η βελτίωση"
],
[
"χρησιμοποιώ use",
"η χρήση"
],
[
"αποφασίζω decide",
"η απόφαση"
],
[
"συμμετέχω take part",
"η συμμετοχή"
],
[
"προστατεύω protect",
"η προστασία"
],
[
"καταναλώνω consume",
"η κατανάλωση"
],
[
"εφαρμόζω apply",
"η εφαρμογή"
],
[
"μολύνω pollute",
"η μόλυνση"
]
]
}
},
{
"table": {
"head": [
"Spoken (verb)",
"Written (noun)"
],
"rows": [
[
