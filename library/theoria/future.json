"level": "A2",
"el": "Ρήματα σε -άω / -ώ και ανώμαλα",
"title": "Verbs in -άω / -ώ and the irregular ones",
"body": [
{
"p": "Verbs in **-άω / -ώ** take their aorist stem in **-ησ-, -ασ-, -εσ-** and stress it: **θα μιλήσω, θα ξεχάσω, θα μπορέσω**."
},
{
"table": {
"head": [
"Present",
"Aorist",
"Future"
],
"rows": [
[
"μιλάω",
"μίλησα",
"θα μιλήσω"
],
[
"ρωτάω",
"ρώτησα",
"θα ρωτήσω"
],
[
"περνάω",
"πέρασα",
"θα περάσω"
],
[
"ξεχνάω",
"ξέχασα",
"θα ξεχάσω"
],
[
"μπορώ",
"μπόρεσα",
"θα μπορέσω"
],
[
"φοράω",
"φόρεσα",
"θα φορέσω"
],
[
"οδηγώ",
"οδήγησα",
"θα οδηγήσω"
]
]
}
},
{
"p": "The irregular verbs use the short dependent stems from chapter 19: **θα πω, θα δω, θα έρθω, θα πάω, θα βρω, θα φάω, θα πιω, θα πάρω, θα μπω, θα βγω**. Verbs with one past have one future too: **θα είμαι, θα έχω, θα ξέρω**."
},
{
"ex": [
{
"el": "Θα του μιλήσω εγώ.",
"en": "I'll talk to him."
},
{
"el": "Θα περάσω από το σπίτι σου.",
"en": "I'll drop by your place."
},
{
"el": "Τι θα φας;",
"en": "What will you eat?"
},
{
"el": "Θα είμαι εκεί στις οχτώ.",
"en": "I'll be there at eight."
},
{
"el": "Θα έχουμε καλό καιρό.",
"en": "We'll have good weather."
}
]
},
{
