"id": "spoken-grammar-6b135909"
},
{
"type": "write",
"q": "\"Actually, I don't have time.\"",
"answer": "Βασικά, δεν έχω χρόνο.",
"accept": [
"Βασικά δεν έχω χρόνο."
],
"why": "βασικά.",
"id": "spoken-grammar-2daed69c"
},
{
"type": "write",
"q": "\"Talk soon!\" (closing a call)",
