"ετοιμάστηκα"
],
[
"στενοχωριέμαι",
"στενοχωρήθηκα",
"παντρεύομαι",
"παντρεύτηκα"
],
[
"βρίσκομαι",
"βρέθηκα",
"ντύνομαι",
