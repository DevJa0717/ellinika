{
"level": "A2",
"el": "Επίθετα σε -ύς, -ιά, -ύ και το πολύς",
"title": "Adjectives in -ύς, -ιά, -ύ, and πολύς",
"body": [
{
"table": {
"head": [
"",
"Masculine",
"Feminine",
"Neuter"
],
"rows": [
[
"Nom. sg",
"βαθύς",
"βαθιά",
"βαθύ"
],
[
"Acc. sg",
"βαθύ",
"βαθιά",
"βαθύ"
],
[
