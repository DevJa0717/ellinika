"type": "choice",
"q": "___ είπα να έρθει. (to him)",
"options": [
"Τον",
"Του",
"Στον",
"Αυτόν"
],
"answer": "Του",
"why": "Indirect object as a weak pronoun: genitive του.",
"id": "cases-418d10c3"
},
