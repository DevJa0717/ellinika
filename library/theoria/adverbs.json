},
{
"level": "A2",
"el": "Επιρρήματα χρόνου",
"title": "Adverbs of time",
"body": [
{
"table": {
"head": [
"Adverb",
"Meaning",
"Adverb",
"Meaning"
],
"rows": [
[
"τώρα",
"now",
"μετά",
"after, later"
],
[
"πριν / προηγουμένως",
"before",
"αμέσως",
"right away"
],
[
"σήμερα",
"today",
"απόψε",
"tonight"
],
[
"χθες / χτες",
"yesterday",
"αύριο",
"tomorrow"
],
[
"προχθές",
"the day before yesterday",
"μεθαύριο",
"the day after tomorrow"
],
[
"φέτος",
"this year",
"πέρσι",
"last year"
],
[
"νωρίς",
"early",
"αργά",
"late"
],
[
"σε λίγο",
"soon, in a bit",
"πρόσφατα",
"recently"
],
[
"ήδη",
"already",
"ακόμα / ακόμη",
"still, yet"
],
[
"πια",
"any more, now (finally)",
"ξανά",
"again"
]
]
}
},
{
"p": "**Ακόμα** and **πια** are a pair:"
},
{
"list": [
"**ακόμα** = still (positive), yet (negative): **Είναι ακόμα εδώ** \"He's still here\"; **Δεν ήρθε ακόμα** \"She hasn't come yet\".",
"**πια** = no longer (with δεν), now / at last (positive): **Δεν καπνίζω πια** \"I don't smoke any more\"; **Έλα πια!** \"Come on, already!\""
]
},
{
"ex": [
{
"el": "Πάμε τώρα ή μετά;",
"en": "Shall we go now or later?"
},
{
"el": "Τα λέμε σε λίγο.",
"en": "See you in a bit."
},
{
"el": "Έχω φάει ήδη.",
"en": "I've already eaten."
},
{
"el": "Δεν μένει πια εδώ.",
"en": "She doesn't live here any more."
},
{
"el": "Ακόμα δουλεύεις;",
"en": "Are you still working?"
},
{
"el": "Πέρσι πήγαμε στη Νάξο, φέτος στην Πάρο.",
"en": "Last year we went to Naxos, this year to Paros."
}
]
},
{
"solved": [
{
"q": "\"I'm still at work.\"",
"a": "Είμαι ακόμα στη δουλειά. | Ακόμα είμαι στη δουλειά.",
"why": "ακόμα = still."
},
{
"q": "\"She doesn't work here any more.\"",
"a": "Δεν δουλεύει πια εδώ. | Δε δουλεύει πια εδώ.",
"why": "δεν ... πια = no longer."
},
{
"q": "\"Have you eaten yet?\"",
"a": "Έφαγες; | Έχεις φάει ακόμα;",
"why": "In a question \"yet\" is usually just the past tense; ακόμα also works."
}
]
},
{
"check": [
{
"type": "choice",
"q": "Δεν έχει έρθει ___. (yet)",
"options": [
"πια",
"ακόμα",
"ήδη",
"ξανά"
],
"answer": "ακόμα",
"why": "Negative + yet = ακόμα.",
"id": "adverbs-09458924"
},
{
"type": "choice",
"q": "Δεν πίνω καφέ ___. (any more)",
"options": [
"ακόμα",
"πια",
"ήδη",
"ποτέ πια ακόμα"
],
"answer": "πια",
"why": "δεν ... πια = no longer.",
"id": "adverbs-94082143"
},
{
"type": "choice",
"q": "Έφυγε ___; (already)",
"options": [
"πια",
"ακόμα",
"ήδη",
"ξανά"
],
"answer": "ήδη",
"why": "ήδη = already.",
"id": "adverbs-706a0433"
},
{
"type": "choice",
"q": "___ πήγαμε στη Σαντορίνη. (last year)",
"options": [
"Φέτος",
"Πέρσι",
"Του χρόνου",
"Απόψε"
],
"answer": "Πέρσι",
"why": "πέρσι = last year.",
"id": "adverbs-03bd4516"
},
{
"type": "choice",
"q": "Θα σε δω ___. (the day after tomorrow)",
"options": [
"προχθές",
"μεθαύριο",
"πέρσι",
"χθες"
],
"answer": "μεθαύριο",
"why": "μεθαύριο.",
"id": "adverbs-de123c02"
},
{
"type": "choice",
