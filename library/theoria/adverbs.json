"απέναντι",
"μακριά",
"πίσω"
],
"answer": "απέναντι",
"why": "απέναντι από = opposite.",
"id": "adverbs-325b9c60"
},
{
"type": "choice",
"q": "Δεν πάω ___ σήμερα.",
"options": [
"κάπου",
"παντού",
"πουθενά",
"αλλού"
],
"answer": "πουθενά",
"why": "With δεν: πουθενά.",
"id": "adverbs-a910d4d2"
},
{
"type": "choice",
"q": "Τα παιδιά παίζουν ___ στον κήπο. (outside)",
"options": [
"μέσα",
"έξω",
"πάνω",
"εκεί πάνω"
],
"answer": "έξω",
"why": "Playing in the garden: έξω.",
"id": "adverbs-cdcc2327"
},
{
"type": "choice",
"q": "Μένει πολύ ___. (far)",
"options": [
"μακρύς",
"μακριά",
"μακρύ",
"μακριός"
],
"answer": "μακριά",
"why": "Adverb: μακριά.",
"id": "adverbs-1d4ee84c"
},
{
"type": "choice",
"q": "Έλα ___ μου. (near)",
"options": [
"κοντά σε",
"κοντά",
"κοντά από",
"κοντός"
],
"answer": "κοντά",
"why": "κοντά + genitive pronoun: κοντά μου.",
"id": "adverbs-a9d7adaa"
},
{
"type": "write",
"q": "Translate: \"Come here!\" (informal)",
"answer": "Έλα εδώ!",
"accept": [],
"why": "εδώ = here.",
"id": "adverbs-60c52403"
},
{
"type": "write",
"q": "Translate: \"inside the box\" (το κουτί)",
