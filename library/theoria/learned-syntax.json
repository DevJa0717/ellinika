{
"level": "C1",
"el": "Παγιωμένοι λόγιοι τύποι",
"title": "Frozen forms of official Greek",
"body": [
{
"table": {
"head": [
"Form",
"Origin",
"Use",
"Meaning"
],
"rows": [
[
"έστω",
"let it be",
"Έστω και αργά, ήρθε.",
"even if late; granted"
],
[
"δέον",
"what is needed",
"τα δέοντα, το δέον γενέσθαι",
"what must be done"
],
[
"ουδείς, ουδεμία, ουδέν",
"no one, nothing",
"Ουδέν σχόλιο. Ουδεμία σχέση.",
"no, none"
],
[
"εκάστοτε",
"each time",
"ο εκάστοτε υπουργός",
"the minister of the day"
],
[
"άπαξ",
"once",
"άπαξ και αποφασίσεις",
"once (you decide)"
],
[
"ενίοτε",
"sometimes",
"",
"sometimes (formal)"
],
[
"εν ολίγοις",
"in a few (words)",
"Εν ολίγοις, απέτυχε.",
"in short"
],
[
"ούτως ή άλλως",
"this way or that",
"Ούτως ή άλλως, θα πάω.",
"anyway"
]
]
}
},
{
"ex": [
{
"el": "Έστω και την τελευταία στιγμή, η συμφωνία υπογράφηκε.",
"en": "Even at the last moment, the agreement was signed."
},
{
"el": "Ουδέν σχόλιο.",
"en": "No comment."
},
{
"el": "Ο εκάστοτε υπουργός αλλάζει το σύστημα.",
"en": "Each successive minister changes the system."
},
{
"el": "Ούτως ή άλλως, δεν είχα χρόνο.",
"en": "In any case, I didn't have time."
}
]
},
{
"tip": "These forms do not decline in normal use (**έστω, δέον, άπαξ**), or decline only in the old way (**ουδείς, ουδεμία, ουδέν**; genitive **ουδενός**). Use them in formal writing or for a deliberately formal, sometimes ironic, effect in speech: **Ουδέν σχόλιο!**"
},
{
"solved": [
{
"q": "\"No comment.\"",
"a": "Ουδέν σχόλιο. | Κανένα σχόλιο.",
"why": "ουδέν = κανένα (formal)."
},
