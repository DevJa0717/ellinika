{
"level": "B1",
"el": "-μένος ή -τός;",
"title": "-μένος or -τός?",
"body": [
{
"p": "Many verbs have, besides the -μένος participle, an adjective in **-τός** (often **-στός, -χτός, -φτός**). The **-τός** adjective names a **kind or permanent quality**; **-μένος** names a **state resulting from an action**."
},
{
"table": {
"head": [
"Verb",
"-τός (quality)",
"-μένος (result)"
],
"rows": [
[
"ανοίγω",
"ανοιχτός \"open\"",
"ανοιγμένος \"opened\""
],
[
"κλείνω",
"κλειστός \"closed\"",
"κλεισμένος \"shut (in), booked\""
],
[
"ψήνω",
"ψητός \"grilled, roast\"",
"ψημένος \"cooked (enough)\""
],
[
"βράζω",
"βραστός \"boiled\"",
"βρασμένος \"boiled (done)\""
],
[
"τηγανίζω",
"τηγανητός \"fried\"",
"τηγανισμένος \"fried (done)\""
],
[
"γράφω",
"γραπτός \"written (exam)\"",
"γραμμένος \"written (down)\""
]
]
}
},
{
"ex": [
{
"el": "Το μαγαζί είναι ανοιχτό μέχρι τις εννιά.",
"en": "The shop is open until nine."
},
{
"el": "Θέλω ένα ψητό κοτόπουλο.",
"en": "I'd like a roast chicken."
},
{
"el": "Το κοτόπουλο είναι καλά ψημένο;",
"en": "Is the chicken well cooked?"
},
{
"el": "Έχουμε γραπτή εξέταση αύριο.",
"en": "We have a written exam tomorrow."
},
{
"el": "Το δωμάτιο είναι κλεισμένο για δύο νύχτες.",
"en": "The room is booked for two nights."
}
]
},
{
"solved": [
{
"q": "\"Fried potatoes\"",
"a": "τηγανητές πατάτες",
"why": "A kind of dish: -τός."
},
{
"q": "\"The door is open.\"",
"a": "Η πόρτα είναι ανοιχτή.",
"why": "A state described as a quality: ανοιχτός."
},
{
"q": "\"The meat isn't cooked enough.\"",
"a": "Το κρέας δεν είναι καλά ψημένο. | Το κρέας δεν είναι αρκετά ψημένο.",
"why": "Result of cooking: -μένος."
}
]
},
