{
 "id": "stress-pairs",
 "el": "Ο τόνος αλλάζει τη σημασία",
 "title": "Words that differ only in stress",
 "level": "A1–B2",
 "intro": [
  "In Greek the accent is part of the spelling because it can change the word. These pairs are spelled with the same letters and told apart only by where the stress falls, so say them aloud as you read. In the drill, a missing or misplaced accent counts as a wrong answer here."
 ],
 "pairs": [
  {
   "words": [
    {
     "el": "πότε",
     "en": "when?"
    },
    {
     "el": "ποτέ",
     "en": "never; ever"
    }
   ],
   "note": "**πότε;** asks *when?*; **ποτέ** is *never* (with δεν) or *ever* (in questions). A classic beginner's slip with a big effect.",
   "ex": [
    {
     "el": "Πότε φεύγεις;",
     "en": "When are you leaving?"
    },
    {
     "el": "Δεν έχω πάει ποτέ στην Κρήτη.",
     "en": "I've never been to Crete."
    }
   ],
   "gaps": [
    {
     "s": "___ θα έρθεις να μας δεις;",
     "a": "Πότε",
     "o": [
      "Ποτέ"
     ],
     "en": "When will you come and see us?"
    },
    {
     "s": "Δεν τρώω ___ κρέας.",
     "a": "ποτέ",
     "o": [
      "πότε"
     ],
     "en": "I never eat meat."
    }
   ]
  },
