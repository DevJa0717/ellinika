       [
        "αν / μήπως",
        "an open question",
        "ρωτάω, δεν ξέρω, αναρωτιέμαι",
        "Δεν ξέρω αν θα έρθει."
       ],
       [
        "μη(ν)",
        "a feared possibility",
        "φοβάμαι, ανησυχώ",
        "Φοβάμαι μη χαθούμε."
       ],
       [
        "το ότι / το να / το αν",
        "a clause as a noun",
        "prepositions; subject position",
        "Παρά το ότι ήταν αργά, ..."
       ]
      ]
     }
    },
    {
     "table": {
      "head": [
       "Verb",
       "+ ότι",
       "+ να"
      ],
      "rows": [
       [
        "ξέρω",
        "know that",
        "know how to"
       ],
       [
        "θυμάμαι",
        "remember that",
        "remember to"
       ],
       [
        "λέω",
        "say that",
        "tell (sb) to; be thinking of"
       ],
       [
        "αρνούμαι",
        "deny that",
        "refuse to"
       ],
       [
        "φοβάμαι",
        "fear that",
        "be afraid to"
       ]
      ]
     }
